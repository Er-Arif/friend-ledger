{
  "expo": {
    "name": "Friend Ledger",
    "slug": "friend-ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "friendledger",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.erarif.friendledger",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Friend Ledger needs camera access to scan QR codes for joining outings."
      }
    },
    "android": {
      "package": "com.erarif.friendledger",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#16A36A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A36A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Friend Ledger to access your camera to scan outing join codes.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c126965d-bcbe-4cc9-8b2b-1bb8a45e54d1"
      }
    }
  }
}
